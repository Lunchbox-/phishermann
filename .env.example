# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The publicly accessible URL where this app is hosted.
# Used to build the tracking link embedded in the phishing simulation email.
APP_URL="https://neoknightlabs.com"

# SMTP configuration — Gmail/Google Workspace via App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_FROM="precisionfluidcontrols@neoknightlabs.com"
SMTP_FROM_NAME="PFC Valves"
# App Password generated from Google Account security settings (no spaces)
SMTP_PASS="hjlgojygewzltbnk"

# ADMIN_SECRET: A simple shared secret to protect the /admin dashboard.
# Include this as a query parameter: /admin?secret=YOUR_SECRET_HERE
ADMIN_SECRET="change-me-before-use"
